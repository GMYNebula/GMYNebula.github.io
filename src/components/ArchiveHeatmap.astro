---
import Icon from './Icon.astro';
import type { HeatmapData } from '@rsalianto/git-heatmap-core';

interface Props {
	data: HeatmapData;
}

const { data } = Astro.props;
const heatmapJson = JSON.stringify(data);
---

<section class="heatmap-panel" data-reveal aria-label="发文热力图">
	<header class="heatmap-head">
		<div>
			<h2><Icon name="archive" size={16} /> 发文热力图</h2>
			<p class="heatmap-stat">
				过去 {data.weeks.length} 周共 <strong>{data.totalContributions}</strong> 篇
			</p>
		</div>
		<a class="heatmap-more" href="/archives/">
			归档 <Icon name="arrow" size={13} />
		</a>
	</header>

	<div class="heatmap-body" data-blog-heatmap-json={heatmapJson}>
		<git-heatmap
			class="nicocat-git-heatmap"
			label="发文热力图"
			show-total="false"
			show-legend="true"
			show-month-labels="true"
			show-day-labels="false"
		></git-heatmap>
	</div>
</section>

<script>
	import { initBlogHeatmap } from '../scripts/post-heatmap-mount.ts';
	initBlogHeatmap();
</script>

<style is:global>
	/* 主题变量：在 host 上覆盖，会传入 git-heatmap Shadow DOM（见 @rsalianto/git-heatmap-vanilla） */
	/*
	  热力图配色：与站内 accent 同一色相的分档，不用 GitHub 绿。
	  白天用 #c44b2f、夜间用 #e8836b 作色相基准，逐档提亮并降低不透明度，
	   使格子仍能回到页面背景色上，而不是像独立色板。
	*/
	html[data-theme='dark'] .nicocat-git-heatmap {
		--ghm-color-l0: rgba(255, 255, 255, 0.08);
		--ghm-color-l1: rgba(232, 131, 107, 0.26);
		--ghm-color-l2: rgba(232, 131, 107, 0.46);
		--ghm-color-l3: rgba(232, 131, 107, 0.68);
		--ghm-color-l4: #e8836b;
		--ghm-text: rgba(255, 255, 255, 0.5);
		--ghm-tooltip-bg: #1c2128;
		--ghm-tooltip-border: rgba(255, 255, 255, 0.1);
		--ghm-tooltip-text: rgba(255, 255, 255, 0.75);
		--ghm-selected: rgba(255, 255, 255, 0.7);
	}

	html[data-theme='light'] .nicocat-git-heatmap {
		--ghm-color-l0: #e7eaee;
		--ghm-color-l1: rgba(196, 75, 47, 0.22);
		--ghm-color-l2: rgba(196, 75, 47, 0.42);
		--ghm-color-l3: rgba(196, 75, 47, 0.68);
		--ghm-color-l4: #c44b2f;
		--ghm-text: rgba(27, 31, 36, 0.55);
		--ghm-tooltip-bg: #fff;
		--ghm-tooltip-border: #d0d7de;
		--ghm-tooltip-text: #24292f;
		--ghm-selected: rgba(27, 31, 36, 0.45);
	}
</style>

<style>
	.heatmap-panel {
		display: grid;
		align-content: start;
		gap: 0.7rem;
		padding: 0.95rem 1.05rem 0.85rem;
		min-width: 0;
	}

	.heatmap-head {
		display: flex;
		align-items: flex-start;
		justify-content: space-between;
		gap: 0.75rem;
	}

	.heatmap-head h2 {
		margin: 0 0 0.2rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-display-stack);
		font-size: 1rem;
		font-weight: 600;
		color: var(--ink);
	}

	.heatmap-stat {
		margin: 0;
		font-size: 0.84rem;
		color: var(--muted);
		font-variant-numeric: tabular-nums;
	}

	.heatmap-stat strong {
		color: var(--ink-soft);
		font-weight: 700;
	}

	.heatmap-more {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.88rem;
		font-weight: 600;
		color: var(--muted);
		text-decoration: none;
		flex-shrink: 0;
	}

	.heatmap-more:hover {
		color: var(--accent);
	}

	.heatmap-body {
		width: 100%;
		min-width: 0;
		overflow: hidden;
	}

	.nicocat-git-heatmap {
		display: block;
		width: 100%;
		min-width: 0;
		--ghm-font: var(--font-body-stack);
		--ghm-fs: 11px;
	}
</style>
