---
import { SITE_AUTHOR, SITE_TAGLINE, SITE_TITLE } from '../consts';

const year = new Date().getFullYear();
---

<footer class="site-footer">
	<div class="inner">
		<p class="line">{SITE_TITLE} · {SITE_TAGLINE}</p>
		<p class="line muted">
			© {year} {SITE_AUTHOR} ·
			<a href="/rss.xml">RSS</a> ·
			<a href="/archives/">归档</a> ·
			<a href="/friends/">友链</a>
		</p>
		<p class="line muted">
			<a href="https://icp.gov.moe/?keyword=20260274" target="_blank" rel="noopener noreferrer">萌ICP备20260274号</a>
		</p>
	</div>
</footer>

<style>
	.site-footer {
		margin-top: 2rem;
		border-top: 1px solid var(--line);
		background: var(--footer-bg);
		backdrop-filter: blur(16px);
		-webkit-backdrop-filter: blur(16px);
	}

	.inner {
		width: min(1080px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 1.75rem 0 2.25rem;
		text-align: center;
	}

	.line {
		margin: 0;
		font-size: 0.92rem;
		line-height: 1.75;
		color: var(--ink-soft);
	}

	.line + .line {
		margin-top: 0.15rem;
	}

	.muted {
		color: var(--muted);
		font-size: 0.88rem;
	}

	a {
		color: var(--ink-soft);
		text-decoration: none;
		font-weight: 600;
	}

	a:hover {
		color: var(--accent);
	}
</style>
