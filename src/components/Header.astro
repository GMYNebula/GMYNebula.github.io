---
import { SITE_TITLE } from '../consts';
import { navItems } from '../data/nav';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import SiteBackground from './SiteBackground.astro';

const section = '/' + (Astro.url.pathname.replace(import.meta.env.BASE_URL, '').match(/[^/]+/)?.[0] ?? '');
---

<SiteBackground />

<header class="site-header">
	<nav>
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">
				<Icon name="mark" size={16} />
			</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="links">
			{
				navItems.map((item) =>
					item.children ? (
						<div class="nav-group">
							<a
								href={item.href}
								class:list={{ active: item.children.some((child) => child.href === section) }}
								aria-haspopup="true"
							>
								<Icon name={item.icon} size={15} />
								{item.label}
								<Icon name="chevron-down" size={13} class="chevron" />
							</a>
							<div class="nav-menu">
								{item.children.map((child) => (
									<a href={child.href} class:list={{ current: child.href === section }}>
										<Icon name={child.icon} size={14} />
										{child.label}
									</a>
								))}
							</div>
						</div>
					) : (
						<HeaderLink href={item.href}>
							<Icon name={item.icon} size={15} />
							{item.label}
						</HeaderLink>
					),
				)
			}
		</div>
		<div class="actions">
			<button type="button" class="icon-btn" id="theme-toggle" aria-label="切换日间夜间">
				<span class="icon-sun"><Icon name="sun" size={17} /></span>
				<span class="icon-moon"><Icon name="moon" size={17} /></span>
			</button>
			<button type="button" class="icon-btn" data-pagefind-open aria-label="搜索">
				<Icon name="search" size={17} />
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const key = 'theme';
		const root = document.documentElement;

		const apply = (theme) => {
			root.setAttribute('data-theme', theme);
			try {
				localStorage.setItem(key, theme);
			} catch {}
			window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
		};

		const bindThemeToggle = () => {
			const btn = document.getElementById('theme-toggle');
			if (!btn || btn.dataset.bound) return;
			btn.dataset.bound = '1';

			btn.addEventListener('click', () => {
				const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
				if (document.startViewTransition) {
					document.startViewTransition(() => apply(next));
				} else {
					apply(next);
				}
			});
		};

		const syncScrollOffset = () => {
			const header = document.querySelector('.site-header');
			const h = header?.offsetHeight ?? 56;
			document.documentElement.style.setProperty('--scroll-offset', `${h + 12}px`);
		};

		bindThemeToggle();
		syncScrollOffset();
		window.addEventListener('resize', syncScrollOffset, { passive: true });

		if (window.__nicocatHeaderBound) return;
		window.__nicocatHeaderBound = true;
		document.addEventListener('astro:page-load', () => {
			bindThemeToggle();
			syncScrollOffset();
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		view-transition-name: site-header;
		padding: 0.7rem 0 0.4rem;
		background: transparent;
	}

	nav {
		width: min(1080px, calc(100% - 2.5rem));
		margin: 0 auto;
		display: grid;
		grid-template-columns: auto minmax(0, 1fr) auto;
		grid-template-areas: 'brand links actions';
		align-items: center;
		gap: 0.75rem 1rem;
	}

	.brand {
		grid-area: brand;
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-display-stack);
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
		flex-shrink: 0;
		text-shadow: 0 1px 10px color-mix(in srgb, var(--bg) 55%, transparent);
	}

	.brand-mark {
		width: 1.85rem;
		height: 1.85rem;
		display: grid;
		place-items: center;
		border-radius: 0.55rem;
		color: #fff;
		background: linear-gradient(145deg, var(--accent) 0%, #d4684f 100%);
		box-shadow: 0 4px 12px var(--accent-glow);
	}

	.brand:hover {
		color: var(--accent);
	}

	.brand:hover .brand-mark {
		filter: brightness(1.06);
	}

	.links {
		grid-area: links;
		display: flex;
		gap: 0.15rem 0.2rem;
		flex-wrap: wrap;
		justify-content: center;
		justify-self: center;
		width: fit-content;
		max-width: 100%;
		padding: 0.28rem 0.4rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: var(--header-bg);
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		box-shadow:
			0 8px 22px color-mix(in srgb, var(--ink) 7%, transparent),
			0 1px 0 color-mix(in srgb, #fff 20%, transparent) inset;
	}

	.links :global(a) {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--muted);
		text-decoration: none;
		position: relative;
		padding: 0.32rem 0.62rem 0.42rem;
	}

	.links :global(a::after) {
		content: '';
		position: absolute;
		left: 50%;
		bottom: 0.08rem;
		width: 0.7rem;
		height: 3px;
		border-radius: 99px;
		background: var(--accent);
		transform: translateX(-50%) scaleX(0);
		transform-origin: center;
		transition: transform 0.3s ease;
	}

	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--ink);
	}

	.links :global(a:hover::after),
	.links :global(a.active::after) {
		transform: translateX(-50%) scaleX(1);
	}

	.nav-group {
		position: relative;
		display: flex;
	}

	.nav-group :global(.chevron) {
		margin-left: -0.1rem;
		transition: transform 0.2s ease;
	}

	/* .links 自带 backdrop-filter，里面的菜单再模糊也看不到页面，所以用不透明底 */
	.nav-menu {
		position: absolute;
		top: calc(100% + 0.5rem);
		left: 50%;
		z-index: 1;
		display: grid;
		gap: 0.1rem;
		min-width: 8.5rem;
		padding: 0.35rem;
		border: 1px solid var(--line);
		border-radius: 0.9rem;
		background: var(--surface);
		box-shadow: var(--shadow-panel);
		opacity: 0;
		visibility: hidden;
		transform: translate(-50%, 4px);
		transition:
			opacity 0.18s ease,
			transform 0.18s ease,
			visibility 0.18s;
	}

	/* 补上父链接和菜单之间的空隙，鼠标移过去时不丢 hover */
	.nav-menu::before {
		content: '';
		position: absolute;
		inset: -0.6rem 0 auto;
		height: 0.6rem;
	}

	.nav-group:hover .nav-menu,
	.nav-group:focus-within .nav-menu {
		opacity: 1;
		visibility: visible;
		transform: translate(-50%, 0);
	}

	.nav-group:hover :global(.chevron),
	.nav-group:focus-within :global(.chevron) {
		transform: rotate(180deg);
	}

	.nav-menu a {
		padding: 0.45rem 0.7rem;
		border-radius: 0.6rem;
		font-size: 0.88rem;
	}

	.nav-menu a::after {
		display: none;
	}

	.nav-menu a:hover {
		background: color-mix(in srgb, var(--ink) 6%, transparent);
	}

	.nav-menu a.current {
		background: var(--accent-glow);
		color: var(--accent-deep);
	}

	.actions {
		grid-area: actions;
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}

	.icon-btn {
		appearance: none;
		width: 2.35rem;
		height: 2.35rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--line);
		background: var(--glass);
		color: var(--ink);
		border-radius: 999px;
		cursor: pointer;
		padding: 0;
		backdrop-filter: blur(8px);
	}

	.icon-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.icon-sun,
	.icon-moon {
		display: none;
		line-height: 0;
	}

	:global(html[data-theme='light']) .icon-moon {
		display: block;
	}

	:global(html[data-theme='dark']) .icon-sun {
		display: block;
	}

	@media (max-width: 860px) {
		nav {
			grid-template-columns: 1fr auto;
			grid-template-areas:
				'brand actions'
				'links links';
		}

		.links {
			justify-self: stretch;
			justify-content: flex-start;
			border-radius: 1.15rem;
			padding: 0.35rem 0.45rem;
		}
	}
</style>
