---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
import Icon from './Icon.astro';
import SiteBackground from './SiteBackground.astro';
---

<SiteBackground />

<header class="site-header">
	<nav>
		<a class="brand" href="/">
			<span class="brand-mark" aria-hidden="true">
				<Icon name="mark" size={16} />
			</span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="links">
			<HeaderLink href="/"><Icon name="home" size={15} />首页</HeaderLink>
			<HeaderLink href="/archives"><Icon name="archive" size={15} />归档</HeaderLink>
			<HeaderLink href="/categories"><Icon name="layers" size={15} />分类</HeaderLink>
			<HeaderLink href="/tags"><Icon name="tag" size={15} />标签</HeaderLink>
			<HeaderLink href="/about"><Icon name="cat" size={15} />关于</HeaderLink>
			<HeaderLink href="/friends"><Icon name="friends" size={15} />友链</HeaderLink>
		</div>
		<div class="actions">
			<button type="button" class="icon-btn" id="theme-toggle" aria-label="切换日间夜间">
				<span class="icon-sun"><Icon name="sun" size={17} /></span>
				<span class="icon-moon"><Icon name="moon" size={17} /></span>
			</button>
			<button type="button" class="icon-btn" data-pagefind-open aria-label="搜索">
				<Icon name="search" size={17} />
			</button>
		</div>
	</nav>
</header>

<script is:inline>
	(() => {
		const key = 'theme';
		const root = document.documentElement;

		const apply = (theme) => {
			root.setAttribute('data-theme', theme);
			try {
				localStorage.setItem(key, theme);
			} catch {}
			window.dispatchEvent(new CustomEvent('themechange', { detail: { theme } }));
		};

		const bindThemeToggle = () => {
			const btn = document.getElementById('theme-toggle');
			if (!btn || btn.dataset.bound) return;
			btn.dataset.bound = '1';

			btn.addEventListener('click', () => {
				const next = root.getAttribute('data-theme') === 'light' ? 'dark' : 'light';
				if (document.startViewTransition) {
					document.startViewTransition(() => apply(next));
				} else {
					apply(next);
				}
			});
		};

		const syncScrollOffset = () => {
			const header = document.querySelector('.site-header');
			const h = header?.offsetHeight ?? 56;
			document.documentElement.style.setProperty('--scroll-offset', `${h + 12}px`);
		};

		bindThemeToggle();
		syncScrollOffset();
		window.addEventListener('resize', syncScrollOffset, { passive: true });

		if (window.__nicocatHeaderBound) return;
		window.__nicocatHeaderBound = true;
		document.addEventListener('astro:page-load', () => {
			bindThemeToggle();
			syncScrollOffset();
		});
	})();
</script>

<style>
	.site-header {
		position: sticky;
		top: 0;
		z-index: 20;
		view-transition-name: site-header;
		backdrop-filter: blur(18px) saturate(1.2);
		-webkit-backdrop-filter: blur(18px) saturate(1.2);
		background: var(--header-bg);
		border-bottom: 1px solid var(--line);
	}

	nav {
		width: min(1080px, calc(100% - 2.5rem));
		margin: 0 auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		padding: 0.9rem 0;
		gap: 0.75rem 1rem;
	}

	.brand {
		display: inline-flex;
		align-items: center;
		gap: 0.55rem;
		font-family: var(--font-display-stack);
		font-size: 1.1rem;
		font-weight: 700;
		letter-spacing: -0.03em;
		color: var(--ink);
		text-decoration: none;
		flex-shrink: 0;
	}

	.brand-mark {
		width: 1.85rem;
		height: 1.85rem;
		display: grid;
		place-items: center;
		border-radius: 0.55rem;
		color: #fff;
		background: linear-gradient(145deg, var(--accent) 0%, #d4684f 100%);
		box-shadow: 0 4px 12px var(--accent-glow);
	}

	.brand:hover {
		color: var(--accent);
	}

	.brand:hover .brand-mark {
		filter: brightness(1.06);
	}

	.links {
		display: flex;
		gap: 0.2rem 0.95rem;
		flex-wrap: wrap;
		justify-content: center;
		flex: 1;
	}

	.links :global(a) {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.9rem;
		font-weight: 600;
		color: var(--muted);
		text-decoration: none;
		position: relative;
		padding: 0.2rem 0;
	}

	.links :global(a::after) {
		content: '';
		position: absolute;
		left: 0;
		bottom: 0;
		width: 100%;
		height: 2px;
		background: var(--accent);
		transform: scaleX(0);
		transform-origin: left;
		transition: transform 0.3s ease;
	}

	.links :global(a:hover),
	.links :global(a.active) {
		color: var(--ink);
	}

	.links :global(a:hover::after),
	.links :global(a.active::after) {
		transform: scaleX(1);
	}

	.actions {
		display: flex;
		align-items: center;
		gap: 0.45rem;
		flex-shrink: 0;
	}

	.icon-btn {
		appearance: none;
		width: 2.35rem;
		height: 2.35rem;
		display: grid;
		place-items: center;
		border: 1px solid var(--line);
		background: var(--glass);
		color: var(--ink);
		border-radius: 999px;
		cursor: pointer;
		padding: 0;
		backdrop-filter: blur(8px);
	}

	.icon-btn:hover {
		border-color: var(--accent);
		color: var(--accent);
	}

	.icon-sun,
	.icon-moon {
		display: none;
		line-height: 0;
	}

	:global(html[data-theme='light']) .icon-moon {
		display: block;
	}

	:global(html[data-theme='dark']) .icon-sun {
		display: block;
	}

	@media (max-width: 720px) {
		nav {
			flex-wrap: wrap;
		}

		.links {
			order: 3;
			width: 100%;
			justify-content: flex-start;
		}
	}
</style>
