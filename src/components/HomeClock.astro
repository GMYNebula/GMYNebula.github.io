---
import Icon from './Icon.astro';
---

<div class="identity-clock" data-home-clock aria-label="北京时间">
	<span class="clock-label"><Icon name="clock" size={13} /> 北京时间</span>
	<time class="clock-time" datetime="" data-clock-time>--:--:--</time>
	<p class="clock-date" data-clock-date>——</p>
</div>

<script>
	const WEEKDAYS = ['周日', '周一', '周二', '周三', '周四', '周五', '周六'];
	/** 北京时间 = Asia/Shanghai（UTC+8，无夏令时） */
	const TZ = 'Asia/Shanghai';

	function tick() {
		const root = document.querySelector('[data-home-clock]');
		if (!root) return;

		const now = new Date();
		const parts = new Intl.DateTimeFormat('en-GB', {
			timeZone: TZ,
			hour: '2-digit',
			minute: '2-digit',
			second: '2-digit',
			hourCycle: 'h23',
			year: 'numeric',
			month: '2-digit',
			day: '2-digit',
		}).formatToParts(now);

		const get = (type) => parts.find((p) => p.type === type)?.value ?? '';
		const h = get('hour');
		const m = get('minute');
		const s = get('second');
		const y = get('year');
		const mo = get('month');
		const d = get('day');

		const localForWeekday = new Date(now.toLocaleString('en-US', { timeZone: TZ }));
		const weekday = WEEKDAYS[localForWeekday.getDay()] ?? '';

		const timeEl = root.querySelector('[data-clock-time]');
		const dateEl = root.querySelector('[data-clock-date]');
		if (timeEl) {
			timeEl.textContent = `${h}:${m}:${s}`;
			timeEl.dateTime = `${y}-${mo}-${d}T${h}:${m}:${s}+08:00`;
		}
		if (dateEl) {
			dateEl.textContent = `${Number(mo)}月${Number(d)}日 ${weekday}`;
		}
	}

	tick();
	window.setInterval(tick, 1000);
	document.addEventListener('astro:page-load', tick);
</script>

<style>
	.identity-clock {
		display: flex;
		justify-content: center;
		align-items: baseline;
		flex-wrap: wrap;
		gap: 0.35rem 0.55rem;
		width: 100%;
		margin-top: 0.75rem;
		padding-top: 0.75rem;
		border-top: 1px solid color-mix(in srgb, var(--line) 70%, transparent);
	}

	.clock-label {
		display: inline-flex;
		align-items: center;
		gap: 0.22rem;
		font-size: 0.75rem;
		font-weight: 650;
		color: var(--muted);
		white-space: nowrap;
	}

	.clock-time {
		font-family: var(--font-display-stack);
		font-size: 0.95rem;
		font-weight: 700;
		letter-spacing: 0.03em;
		line-height: 1;
		color: var(--ink-soft);
		font-variant-numeric: tabular-nums;
	}

	.clock-date {
		margin: 0;
		font-size: 0.75rem;
		font-weight: 600;
		color: var(--muted);
		white-space: nowrap;
	}

	.clock-date::before {
		content: '·';
		margin-right: 0.45rem;
		opacity: 0.5;
	}
</style>
