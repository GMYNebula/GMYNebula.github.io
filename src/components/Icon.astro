---
/**
 * 图标来自 Lucide（ISC）：https://lucide.dev
 * mark / paw 使用官方 paw-print；moon / sun / cat 亦为官方路径。
 */
interface Props {
	name:
		| 'home'
		| 'blog'
		| 'archive'
		| 'tag'
		| 'about'
		| 'friends'
		| 'rss'
		| 'search'
		| 'github'
		| 'code'
		| 'layers'
		| 'cat'
		| 'heart'
		| 'sparkle'
		| 'moon'
		| 'sun'
		| 'paw'
		| 'arrow'
		| 'chevron-down'
		| 'image'
		| 'mark'
		| 'message'
		| 'calendar'
		| 'clock'
		| 'music'
		| 'file-text'
		| 'copy'
		| 'check'
		| 'mail';
	size?: number;
	class?: string;
}

type Shape =
	| { type: 'path'; d: string }
	| { type: 'circle'; cx: number; cy: number; r: number }
