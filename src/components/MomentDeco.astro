---
import Icon from './Icon.astro';
import type { MomentDecoName } from '../utils/moments';

interface Props {
	name: MomentDecoName;
	date: Date;
}

const { name, date } = Astro.props;
const postmarkDate = new Intl.DateTimeFormat('zh-CN', {
	timeZone: 'Asia/Shanghai',
	year: 'numeric',
	month: '2-digit',
	day: '2-digit',
})
	.format(date)
	.replaceAll('/', '.');
---

<span class:list={['deco', name, { tape: name.startsWith('tape-') }]} aria-hidden="true">
	{name === 'tape-text' && '今日份碎碎念'}
	{
		name === 'clip' && (
			<svg viewBox="0 0 21 44" width="22" height="46" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round">
				<path d="M7 14v19a3.5 3.5 0 0 0 7 0V9a5.5 5.5 0 0 0-11 0v25a7.5 7.5 0 0 0 15 0V14" />
			</svg>
		)
	}
	{
		name === 'binder' && (
			<svg viewBox="0 0 40 30" width="40" height="30">
				<path d="M13 14 11 2h18l-2 12" fill="none" stroke="#9aa3ad" stroke-width="2" stroke-linejoin="round" />
				<path d="M6 30 9 12h22l3 18Z" fill="currentColor" />
			</svg>
		)
	}
	{
		name === 'stamp' && (
			<span class="stamp-face">
				<Icon name="paw" size={18} />
				喵
			</span>
		)
	}
	{
		name === 'postmark' && (
			<span class="postmark-face">
				喵喵邮局
				<br />
				{postmarkDate}
			</span>
		)
	}
	{
		name === 'sticker' && (
			<svg viewBox="0 0 24 24" width="38" height="38" overflow="visible">
				<g fill="currentColor" stroke="#fff" stroke-width="2.6" stroke-linejoin="round" paint-order="stroke">
					<circle cx="11" cy="4" r="2" />
					<circle cx="18" cy="8" r="2" />
					<circle cx="20" cy="16" r="2" />
					<path d="M9 10a5 5 0 0 1 5 5v3.5a3.5 3.5 0 0 1-6.84 1.045Q6.52 17.48 4.46 16.84A3.5 3.5 0 0 1 5.5 10Z" />
				</g>
			</svg>
		)
	}
</span>

<style>
	.deco {
		position: absolute;
		pointer-events: none;
	}

	.deco svg {
		display: block;
	}

	/* 胶带：两个伪元素是两条胶带，只有交叉款显示第二条 */
	.tape {
		--tape-color: color-mix(in srgb, var(--accent) 45%, transparent);
		--tape-pattern: repeating-linear-gradient(-45deg, rgb(255 255 255 / 0.35) 0 5px, transparent 5px 10px);
		z-index: 0;
		top: -0.55rem;
		right: 1.6rem;
		width: 4.4rem;
		height: 1.1rem;
		transform: rotate(4deg);
	}

	.tape::before,
	.tape::after {
		content: '';
		position: absolute;
		inset: 0;
		z-index: -1;
		border-radius: 2px;
		background:
			linear-gradient(rgb(255 255 255 / 0.3), transparent 55%),
			var(--tape-pattern),
			var(--tape-color);
		box-shadow: 0 1px 2px rgb(0 0 0 / 0.14);
	}

	.tape::after {
		display: none;
	}

	.tape-dots {
		--tape-color: rgb(127 196 181 / 0.55);
		--tape-pattern: radial-gradient(rgb(255 255 255 / 0.6) 1.5px, transparent 2px) 0 0 / 8px 8px;
		right: auto;
		left: 1.8rem;
		transform: rotate(-5deg);
	}

	.tape-grid {
		--tape-color: rgb(184 164 240 / 0.5);
		--tape-pattern:
			linear-gradient(rgb(255 255 255 / 0.4) 1px, transparent 1px) 0 0 / 7px 7px,
			linear-gradient(90deg, rgb(255 255 255 / 0.4) 1px, transparent 1px) 0 0 / 7px 7px;
		right: auto;
		left: calc(50% - 2.5rem);
		width: 5rem;
		transform: rotate(2deg);
	}

	.tape-paw {
		--tape-pattern: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='16' height='16' viewBox='0 0 16 16'><g fill='white' fill-opacity='.6'><ellipse cx='8' cy='10.2' rx='3' ry='2.4'/><circle cx='4.4' cy='6.8' r='1.2'/><circle cx='6.8' cy='4.9' r='1.2'/><circle cx='9.2' cy='4.9' r='1.2'/><circle cx='11.6' cy='6.8' r='1.2'/></g></svg>") 0 0 / 16px 16px;
		top: -0.2rem;
		right: -1rem;
		width: 3.6rem;
		transform: none;
	}

	.tape-paw::before {
		transform: rotate(38deg);
	}

	.tape-paw::after {
		display: block;
		transform: rotate(-38deg);
	}

	.tape-gingham {
		--tape-color: rgb(120 150 170 / 0.45);
		--tape-pattern:
			linear-gradient(90deg, rgb(255 255 255 / 0.3) 50%, transparent 0) 0 0 / 10px 10px,
			linear-gradient(rgb(255 255 255 / 0.3) 50%, transparent 0) 0 0 / 10px 10px;
		top: 0.3rem;
		right: -1.3rem;
		width: 4.6rem;
		transform: rotate(40deg);
	}

	.tape-star {
		--tape-color: rgb(184 164 240 / 0.5);
		--tape-pattern: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' width='14' height='14' viewBox='0 0 14 14'><path fill='white' fill-opacity='.7' d='m7 2.5 1.3 2.7 3 .4-2.2 2 .6 3L7 9.2l-2.7 1.4.6-3-2.2-2 3-.4Z'/></svg>") 0 0 / 14px 14px;
		right: auto;
		left: 2.6rem;
		width: 4.8rem;
		transform: rotate(3deg);
	}

	.tape-lace {
		--tape-color: rgb(232 150 160 / 0.45);
		--tape-pattern: radial-gradient(rgb(255 255 255 / 0.65) 1.6px, transparent 2px) 0 0 / 7px 7px;
		right: auto;
		left: calc(50% - 3rem);
		width: 6rem;
		height: 1rem;
		transform: rotate(-1.5deg);
	}

	/* 下沿一排半圆缺口，做出蕾丝花边 */
	.tape-lace::before {
		border-radius: 0;
		mask: radial-gradient(circle 3.5px at 50% 100%, transparent 97%, #000) 0 0 / 7px 100% repeat-x;
	}

	.tape-text {
		--tape-color: rgb(196 160 116 / 0.8);
		--tape-pattern: repeating-linear-gradient(90deg, rgb(255 255 255 / 0.12) 0 2px, transparent 2px 5px);
		display: flex;
		align-items: center;
		right: auto;
		left: 1.4rem;
		width: auto;
		padding: 0 0.75rem;
		color: rgb(90 60 30 / 0.85);
		font-family: var(--font-display-stack);
		font-size: 0.7rem;
		letter-spacing: 0.08em;
		transform: rotate(-3deg);
	}

	/* 文具 */
	.clip {
		top: -1.3rem;
		left: 2.2rem;
		color: #6f7985;
		transform: rotate(-6deg);
		filter: drop-shadow(0 1px 1px rgb(0 0 0 / 0.25));
	}

	.pin {
		top: -0.35rem;
		left: calc(50% - 0.5rem);
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		background: radial-gradient(circle at 35% 30%, rgb(255 255 255 / 0.75) 0 12%, var(--accent) 40%, var(--accent-deep));
		box-shadow: 2px 3px 3px rgb(0 0 0 / 0.25);
	}

	.binder {
		top: -1.05rem;
		right: 2rem;
		color: var(--accent);
		filter: drop-shadow(0 1px 1.5px rgb(0 0 0 / 0.3));
	}

	/* 贴纸：邮票四周的齿孔是背景里一格一个圆洞，中间被票面盖住，只露出边上半圈 */
	.stamp {
		top: -0.8rem;
		right: 1.4rem;
		padding: 4px;
		background: radial-gradient(circle at 4px 4px, transparent 2.6px, #fdfbf5 3px) -4px -4px / 8px 8px;
		transform: rotate(6deg);
		filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.22));
	}

	.stamp-face {
		display: flex;
		flex-direction: column;
		align-items: center;
		justify-content: center;
		gap: 2px;
		width: 40px;
		height: 48px;
		background: var(--accent);
		color: #fff;
		font-size: 0.6rem;
		font-weight: 700;
	}

	.postmark {
		top: -0.9rem;
		right: -0.6rem;
		display: grid;
		place-items: center;
		width: 4.3rem;
		height: 4.3rem;
		border: 1.5px solid;
		border-radius: 50%;
		outline: 1px solid;
		outline-offset: -5px;
		color: color-mix(in srgb, var(--accent-deep) 65%, transparent);
		font-size: 0.55rem;
		font-weight: 700;
		line-height: 1.4;
		text-align: center;
		transform: rotate(-14deg);
	}

	/* 邮戳左边的波浪注销线 */
	.postmark::before {
		content: '';
		position: absolute;
		top: calc(50% - 0.55rem);
		right: 100%;
		width: 3rem;
		height: 1.1rem;
		background: currentColor;
		mask: url("data:image/svg+xml,<svg xmlns='http://www.w3.org/2000/svg' viewBox='0 0 48 18' preserveAspectRatio='none'><path d='M0 3q6-3 12 0t12 0 12 0 12 0M0 9q6-3 12 0t12 0 12 0 12 0M0 15q6-3 12 0t12 0 12 0 12 0' fill='none' stroke='black' stroke-width='1.4'/></svg>") 0 0 / 100% 100%;
	}

	.sticker {
		top: -0.9rem;
		right: 1.2rem;
		color: #7fc4b5;
		transform: rotate(14deg);
		filter: drop-shadow(0 1px 2px rgb(0 0 0 / 0.25));
	}

	/* 纸张 */
	.corners {
		inset: -3px;
	}

	.corners::before,
	.corners::after {
		content: '';
		position: absolute;
		width: 1.5rem;
		height: 1.5rem;
		background: color-mix(in srgb, var(--ink) 70%, transparent);
	}

	.corners::before {
		top: 0;
		right: 0;
		clip-path: polygon(0 0, 100% 0, 100% 100%);
	}

	.corners::after {
		bottom: 0;
		left: 0;
		clip-path: polygon(0 0, 0 100%, 100% 100%);
	}

	/* 折起的角：卡片本身在页面里被裁掉右上角，这里补上翻过来的那一块 */
	.dog-ear {
		top: 0;
		right: 0;
		width: 1.6rem;
		height: 1.6rem;
		border-bottom-left-radius: 0.35rem;
		background: linear-gradient(to bottom left, transparent 50%, color-mix(in srgb, var(--ink) 10%, var(--surface)) 50%);
		filter: drop-shadow(-1px 1px 1.5px rgb(0 0 0 / 0.15));
	}

	/* 便利贴顶部的背胶条 */
	.sticky {
		top: 0;
		right: 0;
		left: 0;
		height: 1.6rem;
		border-radius: inherit;
		background: rgb(0 0 0 / 0.04);
	}
</style>
