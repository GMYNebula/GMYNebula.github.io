<div class="reading-progress" aria-hidden="true">
	<span class="reading-progress-bar"></span>
</div>
<button type="button" class="back-to-top" aria-label="回到顶部" hidden>
	<svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
		<path d="M12 19V5M5 12l7-7 7 7" stroke-linecap="round" stroke-linejoin="round"></path>
	</svg>
</button>

<script>
	function initReadingProgress() {
		const bar = document.querySelector('.reading-progress-bar') as HTMLElement | null;
		const btn = document.querySelector('.back-to-top') as HTMLButtonElement | null;
		const article = document.querySelector('[data-pagefind-body]') as HTMLElement | null;
		if (!bar || !btn || !article) return;

		let ticking = false;

		const update = () => {
			ticking = false;
			const rect = article.getBoundingClientRect();
			const scrollTop = window.scrollY;
			const start = scrollTop + rect.top;
			const end = start + article.offsetHeight - window.innerHeight;
			const progress = end <= start ? 1 : Math.min(1, Math.max(0, (scrollTop - start) / (end - start)));
			bar.style.transform = `scaleX(${progress})`;
			btn.hidden = scrollTop < 480;
		};

		const onScroll = () => {
			if (!ticking) {
				ticking = true;
				requestAnimationFrame(update);
			}
		};

		btn.addEventListener('click', () => {
			window.scrollTo({ top: 0, behavior: 'smooth' });
		});

		window.addEventListener('scroll', onScroll, { passive: true });
		window.addEventListener('resize', onScroll, { passive: true });
		update();
	}

	initReadingProgress();
</script>
