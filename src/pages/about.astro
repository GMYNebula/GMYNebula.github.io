---
import AvatarPendant from '../components/AvatarPendant.astro';
import BaseHead from '../components/BaseHead.astro';
import BrandIcon from '../components/BrandIcon.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import Icon from '../components/Icon.astro';
import { profile } from '../data/profile';
import { SITE_AUTHOR, SITE_AUTHOR_EN, SITE_TITLE } from '../consts';
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${SITE_TITLE}`} description={`${SITE_AUTHOR} 是谁呀？`} />
	</head>
	<body>
		<Header />
		<main class="about-page">
			<article class="about-card glass">
				<AvatarPendant alt={`${SITE_AUTHOR} 头像`} size="10rem" width={176} height={176} />

				<header class="hero">
					<h1>{SITE_AUTHOR_EN}</h1>
					<p class="display-name">{SITE_AUTHOR}</p>
					<a class="email" href={`mailto:${profile.email}`}>{profile.email}</a>
				</header>

				<nav class="about-icons" aria-label="社交链接">
					<a
						class="icon-link"
						href={profile.github}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="GitHub"
					>
						<BrandIcon name="github" size={22} />
					</a>
					<a
						class="icon-link"
						href={profile.bilibili}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="Bilibili"
					>
						<BrandIcon name="bilibili" size={22} />
					</a>
					<a
						class="icon-link"
						href={profile.csdn}
						target="_blank"
						rel="noopener noreferrer"
						aria-label="CSDN"
					>
						<BrandIcon name="csdn" size={22} />
					</a>
					<a
						class="icon-link"
						href="#"
						data-qq-add
						data-qq-uin={profile.qq}
						data-qq-card={profile.qqCardUrl}
						aria-label="QQ 加好友"
					>
						<BrandIcon name="qq" size={22} />
					</a>
				</nav>
				<p class="qq-hint" data-qq-hint hidden></p>

				<div class="intro">
					<p>
						你好，我是 <strong>{SITE_AUTHOR}</strong>（{SITE_AUTHOR_EN}）(=^･ω･^=)
					</p>
					<p>人设是猫。喜欢猫娘，也喜欢编程。这里是我的小窝——写代码的碎碎念，和偶尔冒出来的可爱冲动都会住在这儿。</p>
					<p>欢迎坐下来喝杯可可，摸摸猫头再走 ✧</p>
				</div>

				<section class="reward" aria-label="赞赏">
					<button type="button" class="reward-toggle" id="reward-toggle">
						<Icon name="heart" size={15} />
						<span>赞赏作者</span>
					</button>
					<div class="reward-panel" id="reward-panel" hidden>
						<p class="reward-note">请作者喝饮料~</p>
						<ul class="qr-grid">
							<li>
								<a href={profile.qr.wechat} target="_blank" rel="noopener noreferrer">
									<img src={profile.qr.wechat} alt="微信赞赏码" loading="lazy" />
								</a>
								<span><BrandIcon name="wechat" size={14} /> WeChat</span>
							</li>
							<li>
								<a href={profile.qr.qqPay} target="_blank" rel="noopener noreferrer">
									<img src={profile.qr.qqPay} alt="QQ 赞赏码" loading="lazy" />
								</a>
								<span><BrandIcon name="qq" size={14} /> QQ</span>
							</li>
						</ul>
					</div>
				</section>
			</article>
		</main>
		<Footer />
		<script>
			import { bindQQAddButtons } from '../scripts/open-qq.ts';

			const toggle = document.getElementById('reward-toggle');
			const panel = document.getElementById('reward-panel');
			toggle?.addEventListener('click', () => {
				if (!panel) return;
				const open = panel.hasAttribute('hidden');
				panel.toggleAttribute('hidden', !open);
				toggle.setAttribute('aria-expanded', open ? 'true' : 'false');
			});

			bindQQAddButtons();
		</script>
	</body>
</html>

<style>
	.about-page {
		width: min(640px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding: 2rem 0 3.5rem;
		animation: rise 0.65s ease both;
	}

	.about-card {
		padding: 2rem 1.65rem 1.85rem;
		text-align: center;
	}

	.hero h1 {
		margin: 0;
		font-family: var(--font-display-stack);
		font-size: clamp(1.55rem, 4vw, 1.95rem);
		letter-spacing: 0.02em;
	}

	.display-name {
		margin: 0.35rem 0 0;
		color: var(--muted);
		font-size: 0.95rem;
	}

	.email {
		display: inline-block;
		margin-top: 0.55rem;
		color: var(--ink-soft);
		font-size: 0.92rem;
		font-weight: 600;
		text-decoration: none;
		transition: color 0.15s ease;
	}

	.email:hover {
		color: var(--accent-deep);
	}

	.about-icons {
		display: flex;
		justify-content: center;
		align-items: center;
		gap: 0.65rem;
		margin: 1.15rem 0 1.35rem;
	}

	.icon-link {
		display: inline-grid;
		place-items: center;
		width: 2.65rem;
		height: 2.65rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--glass) 90%, transparent);
		color: var(--ink-soft);
		text-decoration: none;
		cursor: pointer;
		font: inherit;
		padding: 0;
		transition:
			border-color 0.15s ease,
			color 0.15s ease,
			background 0.15s ease,
			transform 0.15s ease;
	}

	.icon-link:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		background: var(--accent-glow);
		color: var(--accent-deep);
		transform: translateY(-2px);
	}

	.qq-hint {
		margin: -0.65rem 0 1rem;
		padding: 0.55rem 0.75rem;
		border-radius: 0.55rem;
		border: 1px dashed color-mix(in srgb, var(--accent) 35%, var(--line));
		background: color-mix(in srgb, var(--accent-glow) 45%, transparent);
		color: var(--ink-soft);
		font-size: 0.82rem;
		line-height: 1.5;
	}

	.intro {
		margin: 0;
		padding: 1.15rem 0 0;
		border-top: 1px solid var(--line);
		text-align: left;
	}

	.intro p {
		margin: 0 0 0.8rem;
		color: var(--ink-soft);
		line-height: 1.75;
		font-size: 1rem;
	}

	.intro p:last-child {
		margin-bottom: 0;
	}

	.reward {
		margin-top: 1.35rem;
		padding-top: 1.15rem;
		border-top: 1px solid var(--line);
	}

	.reward-toggle {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		padding: 0.45rem 0.95rem;
		border: 1px solid var(--line);
		border-radius: 999px;
		background: color-mix(in srgb, var(--glass) 88%, transparent);
		color: var(--ink-soft);
		font: inherit;
		font-size: 0.88rem;
		font-weight: 600;
		cursor: pointer;
		transition:
			border-color 0.15s ease,
			background 0.15s ease,
			color 0.15s ease;
	}

	.reward-toggle:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		background: var(--accent-glow);
		color: var(--accent-deep);
	}

	.reward-panel {
		margin-top: 0.95rem;
		padding: 1rem 0.85rem 0.85rem;
		border: 1px solid var(--line);
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--bg-2) 55%, transparent);
		animation: rise 0.35s ease both;
	}

	.reward-note {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.88rem;
	}

	.qr-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		justify-content: center;
		gap: 1.1rem;
		flex-wrap: wrap;
	}

	.qr-grid li {
		display: grid;
		gap: 0.35rem;
		justify-items: center;
	}

	.qr-grid a {
		display: flex;
		align-items: center;
		justify-content: center;
		width: 7.5rem;
		aspect-ratio: 1;
		padding: 0.35rem;
		border: 1px solid var(--line);
		border-radius: 0.55rem;
		background: #fff;
		line-height: 0;
		transition:
			border-color 0.15s ease,
			transform 0.15s ease;
	}

	.qr-grid a:hover {
		border-color: color-mix(in srgb, var(--accent) 45%, transparent);
		transform: translateY(-2px);
	}

	.qr-grid img {
		display: block;
		max-width: 100%;
		max-height: 100%;
		width: auto;
		height: auto;
		object-fit: contain;
	}

	.qr-grid span {
		display: inline-flex;
		align-items: center;
		gap: 0.3rem;
		font-size: 0.78rem;
		color: var(--muted);
		font-weight: 600;
	}
</style>
