---
import BaseHead from '../../components/BaseHead.astro';
import CategoryFolders from '../../components/CategoryFolders.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import { getAllCategories, resolveCategory } from '../../utils/categories';

export async function getStaticPaths() {
	const items = await getAllCategories();
	return items.map((cat) => ({
		params: { category: cat.name },
		props: { categoryName: cat.name },
	}));
}

const { categoryName } = Astro.props;
const displayName = resolveCategory(Astro.params.category!) ?? categoryName;
const items = await getAllCategories();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${displayName} · 分类 · ${SITE_TITLE}`} description={displayName} />
	</head>
	<body>
		<Header />
		<main class="page categories-page">
			<header class="mast">
				<h1>分类</h1>
			</header>
			<CategoryFolders items={items} openName={displayName} />
		</main>
		<Footer />
	</body>
</html>

<style>
	.categories-page {
		width: min(640px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding-top: 2.5rem;
		padding-bottom: 4.5rem;
	}

	.mast {
		margin-bottom: 1.15rem;
		text-align: left;
	}

	.mast h1 {
		margin: 0;
	}
</style>
