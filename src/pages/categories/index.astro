---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import { SITE_TITLE } from '../../consts';
import { getAllCategories } from '../../utils/categories';

const items = await getAllCategories();
const totalPosts = items.reduce((n, cat) => n + cat.count, 0);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`分类 · ${SITE_TITLE}`} description="技术、笔记与日常" />
	</head>
	<body>
		<Header />
		<main class="page categories-page">
			<header class="mast">
				<p class="eyebrow"><Icon name="layers" size={14} /> Categories</p>
				<h1>分类</h1>
			</header>

			<div class="stats glass" aria-label="分类概览">
				<div class="stat">
					<strong>{totalPosts}</strong>
					<span>篇文章</span>
				</div>
			</div>

			<ul class="cat-grid">
				{
					items.map((cat, i) => (
						<li style={`--i:${i};--stagger:${i}`}>
							<article class={`cat-panel glass tone-${cat.tone}`}>
								<a class="cat-top" href={`/categories/${cat.name}/`}>
									<span class="cat-icon" aria-hidden="true">
										<Icon name={cat.icon} size={22} />
									</span>
									<span class="cat-main">
										<strong>{cat.name}</strong>
										<span class="cat-desc">{cat.description}</span>
									</span>
								</a>
								{
									cat.posts.length > 0 ? (
										<ul class="cat-preview">
											{cat.posts.map((post) => (
												<li>
													<a href={`/blog/${post.id}/`}>{post.data.title}</a>
												</li>
											))}
										</ul>
									) : (
										<p class="cat-empty">还没有文章</p>
									)
								}
								<footer class="cat-foot">
									<span class="count">{cat.count} 篇</span>
									<a class="go" href={`/categories/${cat.name}/`}>
										进入
										<Icon name="arrow" size={14} />
									</a>
								</footer>
							</article>
						</li>
					))
				}
			</ul>
		</main>
		<Footer />
	</body>
</html>

<style>
	.categories-page {
		width: min(960px, calc(100% - 2.5rem));
		margin: 0 auto;
		padding-top: 2.5rem;
		padding-bottom: 4.5rem;
	}

	.mast {
		margin-bottom: 1.35rem;
		text-align: center;
		animation: rise 0.55s ease both;
	}

	.eyebrow {
		margin: 0 0 0.45rem;
		display: inline-flex;
		align-items: center;
		justify-content: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.16em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.mast h1 {
		margin: 0 0 0.5rem;
		font-size: clamp(2.2rem, 5.5vw, 3rem);
	}

	.stats {
		display: flex;
		align-items: center;
		justify-content: center;
		gap: 1.5rem;
		width: fit-content;
		margin: 0 auto 1.75rem;
		padding: 0.65rem 1.35rem;
		border-radius: 999px;
		animation: rise 0.6s ease 0.05s both;
	}

	.stat {
		display: grid;
		justify-items: center;
		gap: 0.1rem;
	}

	.stat strong {
		font-family: var(--font-display-stack);
		font-size: 1.35rem;
		font-weight: 700;
		letter-spacing: -0.02em;
		color: var(--ink);
	}

	.stat span {
		font-size: 0.78rem;
		font-weight: 600;
		color: var(--muted);
	}

	.cat-grid {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		grid-template-columns: repeat(3, 1fr);
		gap: 1rem;
	}

	.cat-panel {
		display: flex;
		flex-direction: column;
		min-height: 100%;
		padding: 0;
		overflow: hidden;
		border-top: 3px solid color-mix(in srgb, var(--tone) 70%, var(--line));
		transition:
			transform 0.28s ease,
			border-color 0.28s ease,
			box-shadow 0.28s ease;
		animation: rise-y 0.65s ease both;
		animation-delay: calc(var(--i) * 70ms + 0.08s);
	}

	.cat-panel:hover {
		transform: translateY(-4px);
		border-top-color: color-mix(in srgb, var(--tone) 90%, var(--accent));
		box-shadow: 0 14px 32px color-mix(in srgb, var(--tone) 12%, transparent);
	}

	.cat-top {
		display: grid;
		grid-template-columns: auto 1fr;
		align-items: center;
		gap: 0.85rem;
		padding: 1rem 1.1rem 0.85rem;
		text-decoration: none;
		color: inherit;
	}

	.cat-icon {
		display: grid;
		place-items: center;
		width: 2.75rem;
		height: 2.75rem;
		border-radius: 0.75rem;
		color: color-mix(in srgb, var(--tone) 85%, var(--ink));
		background: color-mix(in srgb, var(--tone) 14%, var(--glass));
		border: 1px solid color-mix(in srgb, var(--tone) 32%, var(--line));
	}

	.cat-main {
		display: grid;
		gap: 0.2rem;
		min-width: 0;
	}

	.cat-main strong {
		font-family: var(--font-display-stack);
		font-size: 1.25rem;
		font-weight: 700;
		letter-spacing: -0.02em;
	}

	.cat-desc {
		font-size: 0.86rem;
		line-height: 1.45;
		color: var(--ink-soft);
	}

	.cat-preview {
		list-style: none;
		margin: 0;
		padding: 0.65rem 1.1rem 0.85rem;
		border-top: 1px solid var(--line);
		background: color-mix(in srgb, var(--tone) 4%, var(--bg-2));
		flex: 1;
	}

	.cat-preview li {
		font-size: 0.82rem;
		line-height: 1.45;
		padding: 0.18rem 0;
	}

	.cat-preview a {
		color: var(--ink-soft);
		text-decoration: none;
		display: block;
		white-space: nowrap;
		overflow: hidden;
		text-overflow: ellipsis;
		transition: color 0.15s ease;
	}

	.cat-preview a:hover {
		color: var(--accent-deep);
	}

	.cat-preview li::before {
		content: '·';
		margin-right: 0.35rem;
		color: color-mix(in srgb, var(--tone) 70%, var(--muted));
	}

	.cat-empty {
		margin: 0 1rem 0.85rem;
		padding: 0.55rem 0.75rem;
		border-radius: 0.65rem;
		font-size: 0.82rem;
		color: var(--muted);
		text-align: center;
		background: color-mix(in srgb, var(--tone) 5%, var(--bg-2));
		border: 1px dashed color-mix(in srgb, var(--tone) 18%, var(--line));
	}

	.cat-foot {
		margin-top: auto;
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 0.75rem;
		padding: 0.85rem 1.15rem;
		border-top: 1px solid var(--line);
		background: color-mix(in srgb, var(--glass) 60%, transparent);
	}

	.count {
		font-size: 0.82rem;
		font-weight: 700;
		color: var(--muted);
	}

	.go {
		display: inline-flex;
		align-items: center;
		gap: 0.25rem;
		font-size: 0.84rem;
		font-weight: 700;
		color: color-mix(in srgb, var(--tone) 75%, var(--ink));
		text-decoration: none;
		transition: transform 0.22s ease, color 0.15s ease;
	}

	.go:hover {
		color: var(--accent-deep);
		transform: translateX(3px);
	}

	.tone-coral {
		--tone: #f0a48e;
	}
	.tone-teal {
		--tone: #7fc4b5;
	}
	.tone-amber {
		--tone: #e6c07b;
	}

	@media (max-width: 820px) {
		.cat-grid {
			grid-template-columns: 1fr;
			max-width: 26rem;
			margin: 0 auto;
		}
	}

	@media (prefers-reduced-motion: reduce) {
		.cat-panel,
		.mast,
		.stats {
			animation: none;
		}
	}
</style>
