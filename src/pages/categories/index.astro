---
import ArchiveTabs from '../../components/ArchiveTabs.astro';
import CategoryFolders from '../../components/CategoryFolders.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { getAllCategories } from '../../utils/categories';

const items = await getAllCategories();
---

<PageLayout title={`分类 · ${SITE_TITLE}`} description="技术、笔记与日常" width="narrow">
	<ArchiveTabs current="/categories" />
	<PageHeader title="分类" />
	<CategoryFolders items={items} />
</PageLayout>
