---
import Comments from '../../components/Comments.astro';
import PageHeader from '../../components/PageHeader.astro';
import { SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { friends } from '../../data/friends';
import { siteLinkCard } from '../../data/profile';

const applyTemplate = `- 网址: 
- 标题: 
- 描述: 
- 头像链接: 
- RSS地址: `;

const siteTemplate = `- 网址: ${siteLinkCard.url}
- 标题: ${siteLinkCard.name}
- 描述: ${siteLinkCard.description}
- 头像链接: ${siteLinkCard.icon}
- RSS地址: ${siteLinkCard.url}/rss.xml`;
---

<PageLayout title={`友链 · ${SITE_TITLE}`} description="朋友们的小站" width="medium">
	<PageHeader
		title="友链"
		eyebrow="Friends"
		icon="friends"
		lede="在本页底部留言申请友链，按下面代码块的五项发我就好。"
	/>

	<section class="apply glass" aria-label="友链申请格式">
		<h2>申请时请发</h2>
		<pre><code>{applyTemplate}</code></pre>
	</section>

	<section class="apply glass" aria-label="本站信息">
		<h2>本站信息（互换用）</h2>
		<pre><code>{siteTemplate}</code></pre>
	</section>

	{
		friends.length > 0 ? (
			<ul class="friends">
				{friends.map((friend) => (
					<li>
						<a href={friend.url} target="_blank" rel="noopener noreferrer">
							<span class="name">
								<img class="avatar" src={friend.avatar} alt="" width="28" height="28" />
								{friend.name}
							</span>
							<span class="desc">{friend.description}</span>
							<span class="url">{friend.url}</span>
						</a>
					</li>
				))}
			</ul>
		) : (
			<p class="empty">友链列表还空着，欢迎来换链 ♪</p>
		)
	}

	<section class="comments-zone" aria-label="友链留言">
		<Comments />
	</section>
</PageLayout>

<style>
	.apply {
		margin-bottom: 1.35rem;
		padding: 1rem 1.15rem;
	}

	.apply h2 {
		margin: 0 0 0.65rem;
		font-size: 0.95rem;
		color: var(--ink-soft);
	}

	.apply pre {
		margin: 0;
	}

	.comments-zone {
		margin-top: 1.35rem;
	}

	.empty {
		margin: 0;
		padding: 1.25rem 1rem;
		text-align: center;
		color: var(--muted);
		border: 1px dashed var(--line);
		border-radius: 0.85rem;
		background: color-mix(in srgb, var(--glass) 70%, transparent);
	}

	.friends {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		gap: 0.75rem;
	}

	.friends a {
		display: grid;
		gap: 0.3rem;
		padding: 1rem 1.15rem;
		border: 1px solid var(--line);
		border-radius: 0.85rem;
		background: var(--glass);
		backdrop-filter: blur(10px);
		text-decoration: none;
		color: inherit;
		transition:
			transform 0.22s ease,
			background 0.22s ease,
			border-color 0.22s ease;
	}

	.friends a:hover {
		transform: translateY(-3px);
		border-color: rgba(232, 131, 107, 0.4);
		background: var(--glass-strong);
	}

	.name {
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-family: var(--font-display-stack);
		font-size: 1.2rem;
		font-weight: 700;
	}

	.avatar {
		width: 1.75rem;
		height: 1.75rem;
		border-radius: 999px;
		object-fit: cover;
	}

	.desc {
		color: var(--ink-soft);
	}

	.url {
		font-size: 0.85rem;
		color: var(--muted);
		word-break: break-all;
	}
</style>
