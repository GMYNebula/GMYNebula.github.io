---
import { render } from 'astro:content';
import MomentDeco from '../../components/MomentDeco.astro';
import PageHeader from '../../components/PageHeader.astro';
import ShareButton from '../../components/ShareButton.astro';
import { SITE_AUTHOR, SITE_TITLE } from '../../consts';
import { profile } from '../../data/profile';
import PageLayout from '../../layouts/PageLayout.astro';
import { getLinkCard } from '../../utils/bookmarks';
import { getPublishedMoments, MOMENT_STYLES, momentPlainText } from '../../utils/moments';

const moments = await getPublishedMoments();
const items = await Promise.all(
	moments.map(async (entry, i) => ({
		entry,
		Content: (await render(entry)).Content,
		card: entry.data.link ? getLinkCard(entry.data.link) : undefined,
		style: MOMENT_STYLES[(moments.length - 1 - i) % MOMENT_STYLES.length],
	})),
);

// 构建机在 UTC，显式指定时区才能显示成发布时的本地时间
const timeFormat = new Intl.DateTimeFormat('zh-CN', {
	timeZone: 'Asia/Shanghai',
	year: 'numeric',
	month: 'long',
	day: 'numeric',
	hour: '2-digit',
	minute: '2-digit',
	hour12: false,
});

function gridCols(count: number) {
	if (count === 1) return 1;
	return count === 2 || count === 4 ? 2 : 3;
}
---

<PageLayout title={`动态 · ${SITE_TITLE}`} description="碎碎念和随手拍" width="medium">
	<PageHeader title="动态" eyebrow="Moments" icon="message" lede="碎碎念和随手拍" />
	{
		items.length === 0 ? (
			<p class="empty">还没有动态喵～</p>
		) : (
			<ol class="feed">
				{items.map(({ entry, Content, card, style }) => (
					<li class="moment" id={`moment-${entry.id}`}>
						<span class="avatar">
							<img
								class="profile-avatar-img"
								src={profile.avatar}
								alt=""
								width="40"
								height="40"
								loading="lazy"
								decoding="async"
							/>
						</span>
						<div class:list={['bubble', 'surface', `paper-${style.paper}`, `with-${style.deco}`]}>
							<MomentDeco name={style.deco} date={entry.data.date} />
							<header class="meta">
								<strong>{SITE_AUTHOR}</strong>
								{entry.data.mood && <span class="mood">{entry.data.mood}</span>}
							</header>
							<div class="prose body">
								<Content />
							</div>
							{entry.data.images.length > 0 && (
								<div class:list={['moment-images', `cols-${gridCols(entry.data.images.length)}`]}>
									{entry.data.images.map((src) => (
										<img src={src} alt="" loading="lazy" decoding="async" />
									))}
								</div>
							)}
							{card && (
								<a class="link-card" href={card.url} target="_blank" rel="noopener noreferrer">
									{card.image && (
										<img
											src={card.image}
											alt=""
											loading="lazy"
											decoding="async"
											referrerpolicy="no-referrer"
											onerror="this.remove()"
										/>
									)}
									<span class="link-info">
										<span class="link-title">{card.title}</span>
										<span class="link-source">{card.source}</span>
									</span>
								</a>
							)}
							{entry.data.tags.length > 0 && (
								<p class="tags">
									{entry.data.tags.map((tag) => (
										<span>#{tag}</span>
									))}
								</p>
							)}
							<p class="foot">
								<time datetime={entry.data.date.toISOString()} title={timeFormat.format(entry.data.date)}>
									{timeFormat.format(entry.data.date)}
								</time>
								<span>· {entry.data.location}</span>
								<ShareButton
									path={`/moments/#moment-${entry.id}`}
									text={momentPlainText(entry.body)}
									date={timeFormat.format(entry.data.date)}
								/>
							</p>
						</div>
					</li>
				))}
			</ol>
		)
	}
</PageLayout>

<script>
	// 页面是构建时生成的，"今天/昨天"只能在浏览器里按当前时间算；按北京时间的日历天比较，往年保留构建时的完整日期
	const TZ = 'Asia/Shanghai';
	const dayKey = new Intl.DateTimeFormat('en-CA', { timeZone: TZ });
	const clock = new Intl.DateTimeFormat('zh-CN', { timeZone: TZ, hour: '2-digit', minute: '2-digit', hour12: false });
	const monthDay = new Intl.DateTimeFormat('zh-CN', { timeZone: TZ, month: 'long', day: 'numeric' });
	const DAY_NAMES = ['今天', '昨天', '前天'];

	function showFriendlyTime() {
		const now = new Date();
		for (const el of document.querySelectorAll<HTMLTimeElement>('.moment time')) {
			const date = new Date(el.dateTime);
			const minutes = Math.floor((now.getTime() - date.getTime()) / 60000);
			const days = (Date.parse(dayKey.format(now)) - Date.parse(dayKey.format(date))) / 86400000;
			if (minutes < 0) continue;
			if (minutes < 1) el.textContent = '刚刚';
			else if (minutes < 60) el.textContent = `${minutes} 分钟前`;
			else if (days < DAY_NAMES.length) el.textContent = `${DAY_NAMES[days]} ${clock.format(date)}`;
			else if (dayKey.format(now).slice(0, 4) === dayKey.format(date).slice(0, 4)) {
				el.textContent = `${monthDay.format(date)} ${clock.format(date)}`;
			}
		}
	}

	document.addEventListener('astro:page-load', showFriendlyTime);
</script>

<style>
	.empty {
		color: var(--muted);
	}

	.feed {
		display: grid;
		gap: 1.5rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}

	.moment {
		display: flex;
		align-items: flex-start;
		gap: 0.9rem;
		animation: rise 0.55s ease backwards;
	}

	.avatar {
		flex-shrink: 0;
		width: 2.5rem;
		height: 2.5rem;
		overflow: hidden;
		border: 2px solid color-mix(in srgb, var(--accent) 42%, var(--line));
		border-radius: 999px;
		background: var(--bg-2);
		transition: transform 0.25s ease;
	}

	.bubble {
		--paper: var(--surface);
		--paper-line: color-mix(in srgb, var(--ink) 7%, transparent);
		position: relative;
		flex: 1;
		min-width: 0;
		padding: 1rem 1.3rem 1.05rem;
		background-color: var(--paper);
		transition: transform 0.25s ease;
	}

	/* 指向头像的气泡尖角：与卡片同底色、同边框的方块转 45° */
	.bubble::before {
		content: '';
		position: absolute;
		top: 0.9rem;
		left: -7px;
		width: 12px;
		height: 12px;
		border-bottom: 1px solid var(--line);
		border-left: 1px solid var(--line);
		background: var(--paper);
		transform: rotate(45deg);
	}

	/* 卡片底纹 */
	.paper-grid {
		background-image:
			linear-gradient(var(--paper-line) 1px, transparent 1px),
			linear-gradient(90deg, var(--paper-line) 1px, transparent 1px);
		background-size: 1.25rem 1.25rem;
	}

	/* 横线纸，左边一条淡红的页边线 */
	.paper-lined {
		background-image:
			linear-gradient(
				90deg,
				transparent 0.7rem,
				color-mix(in srgb, var(--accent) 25%, transparent) 0.7rem calc(0.7rem + 1px),
				transparent 0
			),
			repeating-linear-gradient(
				transparent 0 calc(1.8rem - 1px),
				color-mix(in srgb, var(--ink) 4.5%, transparent) 0 1.8rem
			);
	}

	.paper-dots {
		background-image: radial-gradient(color-mix(in srgb, var(--ink) 16%, transparent) 1px, transparent 1.5px);
		background-size: 1.1rem 1.1rem;
	}

	.paper-kraft {
		--paper: color-mix(in srgb, #c8a27a 20%, var(--surface));
	}

	.paper-sticky {
		--paper: color-mix(in srgb, #ffe27a 30%, var(--surface));
		border-radius: 0.2rem;
		rotate: -0.8deg;
	}

	/* 深色底上黄色比例高了会发灰发绿 */
	:global([data-theme='dark']) .paper-sticky {
		--paper: color-mix(in srgb, #ffd35a 11%, var(--surface));
	}

	.with-corners {
		border-radius: 0.25rem;
	}

	/* 裁掉右上角给折角让位；多边形向外多留 20px，别把阴影和气泡尖角一起裁掉 */
	.with-dog-ear {
		clip-path: polygon(
			-20px -20px,
			calc(100% - 1.6rem - 20px) -20px,
			calc(100% + 20px) calc(1.6rem + 20px),
			calc(100% + 20px) calc(100% + 30px),
			-20px calc(100% + 30px)
		);
	}

	.moment:hover .bubble {
		transform: translateY(-2px);
	}

	.moment:hover .avatar {
		transform: rotate(-10deg);
	}

	.meta {
		display: flex;
		align-items: center;
		gap: 0.6rem;
	}

	/* 头像是全身立绘，小尺寸下放大到只露出头部 */
	.avatar img {
		transform: scale(2.4);
	}

	.meta strong {
		font-size: 0.95rem;
	}

	.mood {
		padding: 0.1rem 0.55rem;
		border-radius: 999px;
		background: var(--accent-glow);
		color: var(--accent-deep);
		font-size: 0.75rem;
		font-weight: 600;
	}

	.body {
		margin-top: 0.45rem;
	}

	.body :global(> :first-child) {
		margin-top: 0;
	}

	.body :global(> :last-child) {
		margin-bottom: 0;
	}

	.moment-images {
		display: grid;
		gap: 0.4rem;
		max-width: 30rem;
		margin-top: 0.85rem;
	}

	.moment-images img {
		width: 100%;
		aspect-ratio: 1;
		object-fit: cover;
		border-radius: 0.6rem;
		border: 1px solid var(--line);
	}

	.cols-1 {
		max-width: 20rem;
	}

	.cols-1 img {
		aspect-ratio: auto;
	}

	.cols-2 {
		grid-template-columns: repeat(2, 1fr);
	}

	.cols-3 {
		grid-template-columns: repeat(3, 1fr);
	}

	.link-card {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		max-width: 30rem;
		margin-top: 0.85rem;
		padding: 0.5rem;
		border: 1px solid var(--line);
		border-radius: 0.7rem;
		background: color-mix(in srgb, var(--accent) 5%, var(--surface));
		color: inherit;
		text-decoration: none;
		transition: border-color 0.2s ease;
	}

	.link-card:hover {
		border-color: var(--accent);
	}

	.link-card img {
		flex-shrink: 0;
		width: 6.5rem;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0.45rem;
	}

	.link-info {
		display: flex;
		flex-direction: column;
		gap: 0.25rem;
		min-width: 0;
	}

	.link-title {
		display: -webkit-box;
		-webkit-box-orient: vertical;
		-webkit-line-clamp: 2;
		overflow: hidden;
		font-size: 0.88rem;
		font-weight: 600;
		line-height: 1.4;
	}

	.link-source {
		font-size: 0.75rem;
		color: var(--muted);
	}

	.tags {
		display: flex;
		flex-wrap: wrap;
		gap: 0.3rem 0.7rem;
		margin: 0.75rem 0 0;
		font-size: 0.84rem;
		color: var(--accent-deep);
	}

	.foot {
		display: flex;
		align-items: center;
		gap: 0.35rem;
		margin: 0.75rem 0 0;
		font-size: 0.78rem;
		color: var(--muted);
	}

	.foot :global(.share-button) {
		margin-left: auto;
	}
</style>
