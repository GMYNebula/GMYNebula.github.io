---
import Icon from '../../components/Icon.astro';
import PageHeader from '../../components/PageHeader.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import PageLayout from '../../layouts/PageLayout.astro';
import { getAllTags, slugToTag } from '../../utils/tags';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag: tag.name },
		props: {
			tagName: tag.name,
			posts: tag.posts.filter((p) => !p.data.draft),
			siblings: tags
				.filter((t) => t.name !== tag.name && t.posts.some((p) => !p.data.draft))
				.slice(0, 6)
				.map((t) => ({ name: t.name, slug: t.slug, count: t.count })),
		},
	}));
}

const { tagName, posts, siblings } = Astro.props;
const displayTag = tagName ?? slugToTag(Astro.params.tag!);
---

<PageLayout title={`${displayTag} · 标签 · ${SITE_TITLE}`} description={`#${displayTag}`} width="medium">
	<PageHeader title={displayTag} eyebrow="Tag" icon="tag" lede={`${posts.length} 篇`} size="large">
		<a slot="before" class="back" href="/tags">← 全部标签</a>
		<Fragment slot="title"><span class="hash">#</span>{displayTag}</Fragment>
	</PageHeader>

	<PostList posts={posts} variant="card" />

	{
		siblings?.length > 0 && (
			<section class="more">
				<h2>
					<Icon name="sparkle" size={16} /> 其他话题
				</h2>
				<ul>
					{siblings.map((t) => (
						<li>
							<a href={`/tags/${t.slug}/`}>
								{t.name}
								<span>{t.count}</span>
							</a>
						</li>
					))}
				</ul>
			</section>
		)
	}
</PageLayout>

<style>
	.back {
		display: block;
		width: fit-content;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--muted);
		text-decoration: none;
	}

	.back:hover {
		color: var(--accent);
	}

	.hash {
		margin-right: 0.2rem;
		color: var(--accent);
		opacity: 0.85;
	}

	.more {
		margin-top: 2.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.more h2 {
		margin: 0 0 0.9rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 1.15rem;
	}

	.more ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.more a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--glass);
		text-decoration: none;
		color: var(--ink);
		font-weight: 600;
		font-size: 0.92rem;
		transition:
			transform 0.22s ease,
			border-color 0.22s ease,
			background 0.22s ease;
	}

	.more a:hover {
		transform: translateY(-3px);
		border-color: rgba(232, 131, 107, 0.45);
		background: var(--accent-glow);
	}

	.more a span {
		font-size: 0.78rem;
		color: var(--muted);
	}
</style>
