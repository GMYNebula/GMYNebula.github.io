---
import BaseHead from '../../components/BaseHead.astro';
import Footer from '../../components/Footer.astro';
import Header from '../../components/Header.astro';
import Icon from '../../components/Icon.astro';
import PostList from '../../components/PostList.astro';
import { SITE_TITLE } from '../../consts';
import { getAllTags, slugToTag } from '../../utils/tags';

export async function getStaticPaths() {
	const tags = await getAllTags();
	return tags.map((tag) => ({
		params: { tag: tag.name },
		props: {
			tagName: tag.name,
			posts: tag.posts.filter((p) => !p.data.draft),
			siblings: tags
				.filter((t) => t.name !== tag.name && t.posts.some((p) => !p.data.draft))
				.slice(0, 6)
				.map((t) => ({ name: t.name, slug: t.slug, count: t.count })),
		},
	}));
}

const { tagName, posts, siblings } = Astro.props;
const displayTag = tagName ?? slugToTag(Astro.params.tag!);
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={`${displayTag} · 标签 · ${SITE_TITLE}`}
			description={`#${displayTag}`}
		/>
	</head>
	<body>
		<Header />
		<main class="page narrow">
			<header class="mast">
				<a class="back" href="/tags">← 全部标签</a>
				<p class="eyebrow"><Icon name="tag" size={14} /> Tag</p>
				<h1>
					<span class="hash">#</span>
					{displayTag}
				</h1>
				<p class="meta">{posts.length} 篇</p>
			</header>

			<PostList posts={posts} variant="card" />

			{
				siblings?.length > 0 && (
					<section class="more">
						<h2>
							<Icon name="sparkle" size={16} /> 其他话题
						</h2>
						<ul>
							{siblings.map((t) => (
								<li>
									<a href={`/tags/${t.slug}/`}>
										{t.name}
										<span>{t.count}</span>
									</a>
								</li>
							))}
						</ul>
					</section>
				)
			}
		</main>
		<Footer />
	</body>
</html>

<style>
	.narrow {
		width: min(820px, calc(100% - 2.5rem));
	}

	.mast {
		margin-bottom: 2rem;
		animation: rise 0.55s ease both;
	}

	.back {
		display: inline-block;
		margin-bottom: 1rem;
		font-size: 0.9rem;
		font-weight: 700;
		color: var(--muted);
		text-decoration: none;
	}

	.back:hover {
		color: var(--accent);
	}

	.eyebrow {
		margin: 0 0 0.4rem;
		display: inline-flex;
		align-items: center;
		gap: 0.35rem;
		font-size: 0.78rem;
		font-weight: 700;
		letter-spacing: 0.18em;
		text-transform: uppercase;
		color: var(--accent);
	}

	.mast h1 {
		margin: 0 0 0.45rem;
		display: flex;
		align-items: baseline;
		gap: 0.2rem;
		font-size: clamp(2.2rem, 5vw, 3rem);
	}

	.hash {
		color: var(--accent);
		opacity: 0.85;
	}

	.meta {
		margin: 0;
		color: var(--muted);
		font-weight: 600;
	}

	.more {
		margin-top: 2.75rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--line);
	}

	.more h2 {
		margin: 0 0 0.9rem;
		display: inline-flex;
		align-items: center;
		gap: 0.4rem;
		font-size: 1.15rem;
	}

	.more ul {
		list-style: none;
		margin: 0;
		padding: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.55rem;
	}

	.more a {
		display: inline-flex;
		align-items: baseline;
		gap: 0.4rem;
		padding: 0.4rem 0.85rem;
		border-radius: 999px;
		border: 1px solid var(--line);
		background: var(--glass);
		text-decoration: none;
		color: var(--ink);
		font-weight: 600;
		font-size: 0.92rem;
		transition:
			transform 0.22s ease,
			border-color 0.22s ease,
			background 0.22s ease;
	}

	.more a:hover {
		transform: translateY(-3px);
		border-color: rgba(232, 131, 107, 0.45);
		background: var(--accent-glow);
	}

	.more a span {
		font-size: 0.78rem;
		color: var(--muted);
	}
</style>
